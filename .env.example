# ---- 数据库（必填）----
# PostgreSQL 连接串。未配置时 App 会降级为本地模式（AsyncStorage），仍可演示核心闭环。
DATABASE_URL=postgresql://postgres:password@localhost:5432/mira

# ---- 认证（必填）----
# JWT 签名密钥，至少 32 位随机字符串
JWT_SECRET=change-this-to-a-random-32-char-string

# ---- AI（可选，二选一；都不配则使用确定性 mock 数据）----
# 优先使用 Anthropic Claude（多模态视觉，推荐）
ANTHROPIC_API_KEY=
# 或使用 OpenAI gpt-4o
OPENAI_API_KEY=

# ---- 前端 API 地址（本地开发可留空，会自动推断）----
EXPO_PUBLIC_API_BASE_URL=

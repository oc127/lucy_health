  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "concurrently -n server,metro -c blue,magenta \"pnpm dev:server\" \"pnpm dev:metro\"",
    "dev:server": "tsx watch server/_core/index.ts",
    "dev:metro": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "qr": "expo start",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
